SELECT department_id,
  sum(salary),
  round(avg(salary), 2) avg_salary,
  round(var_pop(salary), 2) var_salary,
  round(stddev_pop(salary), 2) stddev_salary
FROM data_sci.employees
GROUP BY department_id


SELECT last_name,
  department_id,
  salary
FROM data_sci.employees
WHERE last_name like 'b%'
  AND department_id in (2, 4, 6, 7, 8)
  AND salary > 100000


SELECT department_id,
  sum(salary)
FROM data_sci.employees
WHERE salary > 100000
group by department_id


SELECT e.last_name,
  e.email,
  cd.department_name
FROM data_sci.employees e
  JOIN data_sci.company_departments cd ON e.department_id = cd.id
WHERE e.salary > 120000


SELECT upper(department_name),
  initcap(department_name),
  lower(department_name)
FROM data_sci.company_departments

SELECT ' Kelly' = 'Kelly'
SELECT ltrim('    Kelly') = 'Kelly'
SELECT rtrim('Kelly     ') = 'Kelly'
SELECT ltrim(rtrim('    Kelly   ')) = 'Kelly'


SELECT job_title || '-' || last_name
FROM data_sci.employees


SELECT SUBSTRING('abcdefgk', 1, 3) test_string
SELECT job_title,
  (job_title like '%assistant%') is_assistant
FROM data_sci.employees


SELECT DISTINCT job_title
FROM data_sci.employees
WHERE job_title like 'vp%'
  OR job_title like 'web%'


SELECT DISTINCT job_title
FROM data_sci.employees
WHERE job_title similar to '(vp%|web%)'


SELECT DISTINCT job_title
FROM data_sci.employees
WHERE job_title similar to 'vp (a|m)%' % round numbers


SELECT round(avg(salary), 2),
  trunc(avg(salary), 2),
  ceil(avg(salary))
FROM data_sci.employees % fuzzystring match


